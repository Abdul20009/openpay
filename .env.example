# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://openpay:openpay@localhost:5432/openpay

# Provider secret keys (sandbox/test first). Never put real keys in this file.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
BACHS_SECRET_KEY=

# Webhook verification secrets (per provider dashboard settings)
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
BACHS_WEBHOOK_SECRET=
https://c75e-197-210-8-192.ngrok-free.app
# Default provider for openpay.payments.create() when `provider` is omitted
OPENPAY_DEFAULT_PROVIDER=paystack

# Local webhook receiver port (`npm run receiver`)
PORT=3000
