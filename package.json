{
  "name": "openpay-ng",
  "version": "0.1.1",
  "description": "OpenPay NG — unified SDK for Nigerian payment providers (Paystack, Flutterwave, Bachs)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "example": "tsx examples/basic-usage.ts",
    "receiver": "tsx src/server.ts",
    "smoke:consumer": "node scripts/consumer-smoke.mjs"
  },
  "keywords": [
    "payments",
    "nigeria",
    "paystack",
    "flutterwave",
    "bachs"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
